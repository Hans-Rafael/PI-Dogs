# TheDogAPI Key - Get yours from https://thedogapi.com/
API_KEY=your_thedogapi_key

# Local PostgreSQL Database Configuration (desarrollo)
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost:5432

# Produccion (Render): si existe, reemplaza la configuracion DB_* anterior
# DATABASE_URL=postgres://user:password@host:5432/dbname

# Puerto opcional (Render lo asigna automaticamente)
# PORT=3001
